.info-components {
  width: 100%;
  height: fit-content;
  top: 35%;
  space-between-entries: 5;

  Component {
    alignment-x: center;

    &.empty-label {
      text-color: blue;
    }

    &.hint-label {
      text-color: dark_gray;
    }
  }
}

Scroll {
  width: 100%;
  height: 100%;

  .player-list {
    width: 100%;
    height: 100%;

    BlockedPlayer {
      width: 100%;
      height: 20;
      padding: 1;

      .avatar {
        width: 16;
        height: width;
        margin: 0 3 0 3;
      }

      .remove-button {
        padding: 0;
        height: 20;
        width: height;
        alignment: right;

        Component {
          text-color: white !important;
        }

        &:hover {
          Component {
            text-color: red !important;
          }
        }
      }
    }
  }
}